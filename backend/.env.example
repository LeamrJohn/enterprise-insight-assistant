APP_NAME=Agent Platform API
APP_ENV=development
APP_DEBUG=false
LOG_LEVEL=INFO
LOG_DIR=./logs
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
JWT_SECRET=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=30
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=20
INPUT_ARTIFACT_DOCUMENT_MAX_SIZE_MB=20
INPUT_ARTIFACT_TABLE_MAX_SIZE_MB=50
INPUT_ARTIFACT_IMAGE_MAX_SIZE_MB=10
ALLOWED_DOCUMENT_EXTENSIONS=[".txt", ".pdf", ".md",".markdown"]
UPLOAD_CHUNK_SIZE_BYTES=1048576

REDIS_URL=redis://127.0.0.1:6379/0
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=agent_platform
DATABASE_USER=agent_app
DATABASE_PASSWORD=replace_with_your_project_password
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=5
ANALYSIS_TASK_COMPANY_INFLIGHT_LIMIT=5
ANALYSIS_TASK_GLOBAL_INFLIGHT_LIMIT=20
ANALYSIS_TASK_ADMISSION_RETRY_AFTER_SECONDS=30
ANALYSIS_TASK_CAPACITY_ADMISSION_ENABLED=false
ANALYSIS_TASK_CAPACITY_SIGNAL_URL=
ANALYSIS_TASK_CAPACITY_SIGNAL_TOKEN=
ANALYSIS_TASK_CAPACITY_LOW_WATERMARK_BYTES=536870912
ANALYSIS_TASK_CAPACITY_SIGNAL_MAX_AGE_SECONDS=5
ANALYSIS_TASK_CAPACITY_SIGNAL_TIMEOUT_SECONDS=1
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
OPENAI_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1024
# Server-owned limits, frozen into each task at admission. Clients cannot raise them.
ANALYSIS_TASK_MODEL_MAX_CALLS=8
ANALYSIS_TASK_MODEL_MAX_CALLS_PER_NODE=4
ANALYSIS_TASK_MODEL_MAX_REPAIRS=2
ANALYSIS_TASK_MODEL_MAX_TOTAL_TOKENS=16000
ANALYSIS_TASK_MODEL_MAX_COST=0.15
DEEPSEEK_API_KEY=
# Conservative peak, cache-miss rates for the legacy deepseek-v4-flash alias.
# Revalidate against the provider price page before changing models or prices.
MODEL_PRICE_TABLE_VERSION=deepseek-v4.1-flash-peak-2026-10-10
MODEL_PRICE_TABLE=[{"price_id":"deepseek-v4.1-flash-peak-cache-miss","provider":"deepseek","model_name":"deepseek-v4-flash","parameters":{},"prompt_per_1k":"0.0003","completion_per_1k":"0.0012"}]
BUSINESS_DATABASE_HOST=business_db
BUSINESS_DATABASE_PORT=5432
BUSINESS_DATABASE_NAME=business_data
BUSINESS_DATABASE_USER=business_readonly
BUSINESS_DATABASE_PASSWORD=replace_with_readonly_password
ACME_DEMO_DATABASE_PASSWORD=acme_demo_readonly_password
BETA_DEMO_DATABASE_PASSWORD=beta_demo_readonly_password
INPUT_ARTIFACT_UPLOAD_LEASE_SECONDS=120
INPUT_ARTIFACT_DIRECT_UPLOAD_TTL_SECONDS=900
INPUT_ARTIFACT_CLAMD_HOST=clamd
INPUT_ARTIFACT_CLAMD_PORT=3310
INPUT_ARTIFACT_CLAMD_TIMEOUT_SECONDS=30
INPUT_ARTIFACT_CLAMD_PROCESSOR_VERSION=1.5.4
INPUT_ARTIFACT_PARSER_PROCESSOR_VERSION=1.0.0
INPUT_ARTIFACT_OCR_LANGUAGES=chi_sim+eng
INPUT_ARTIFACT_OCR_TIMEOUT_SECONDS=30
INPUT_ARTIFACT_IMAGE_MAX_PIXELS=25000000
INPUT_ARTIFACT_OCR_MINIMUM_CONFIDENCE=60.0
INPUT_ARTIFACT_PDF_RENDER_TIMEOUT_SECONDS=30
INPUT_ARTIFACT_PDF_RENDER_MAX_SIDE_PIXELS=2048
INPUT_ARTIFACT_PDF_MAX_OCR_PAGES=20
INPUT_ARTIFACT_OBJECT_STORAGE_ENDPOINT_URL=
INPUT_ARTIFACT_OBJECT_STORAGE_PUBLIC_ENDPOINT_URL=
INPUT_ARTIFACT_OBJECT_STORAGE_REGION=us-east-1
INPUT_ARTIFACT_OBJECT_STORAGE_BUCKET=
INPUT_ARTIFACT_OBJECT_STORAGE_ACCESS_KEY_ID=
INPUT_ARTIFACT_OBJECT_STORAGE_SECRET_ACCESS_KEY=
INPUT_ARTIFACT_OBJECT_STORAGE_HEALTH_TIMEOUT_SECONDS=3
