# P0 baseline test environment. Copy this to .env.p0.local (which stays ignored)
# and replace only the two password placeholders on the local machine.
#
# Run with:
#   .\scripts\ops\collect-baseline-audit.ps1 ... -TestEnvironmentFile .\backend\.env.p0.local
APP_ENV=test
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
DATABASE_NAME=agent_platform_test
DATABASE_USER=agent_app
DATABASE_PASSWORD=replace_with_local_platform_test_password
BUSINESS_DATABASE_HOST=127.0.0.1
BUSINESS_DATABASE_PORT=5434
BUSINESS_DATABASE_NAME=business_data
BUSINESS_DATABASE_USER=business_readonly
BUSINESS_DATABASE_PASSWORD=replace_with_local_business_readonly_password
